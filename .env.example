# Copier en .env (jamais commité) pour lancer les scripts scripts/sync-*.mjs en local.
# La clé service role vient du dashboard Supabase (Settings > API) — jamais
# dans le code, jamais dans la clé anon utilisée par le client (src/lib/supabase.js).
SUPABASE_URL=https://okocdleedpysinvsxfim.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Client ID récupéré sur myanimelist.net/apiconfig/create (appli "non-commerciale"
# au départ suffit — voir supabase_catalog.sql / plan de migration pour le contexte).
MAL_CLIENT_ID=
